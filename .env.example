# Copy to .env and fill in. Never commit .env.

# --- Database (Dev 1) ---
# Leave empty to use an embedded PGlite database in ./.data (no Postgres needed for local dev).
DATABASE_URL=

# --- PayPal sandbox (Dev 1) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- LLM (AI 1) ---
ANTHROPIC_API_KEY=
# Main model for planning, receipts, reconciliation explanations
LLM_MODEL=claude-opus-5-5
# Smaller model for classification and message drafting
LLM_MODEL_FAST=claude-haiku-5-5

# --- App URLs ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Policy (AI 3) ---
POLICY_FILE=policies/demo-event.yaml

# --- Demo mode: judges can use the workspace without PayPal accounts ---
DEMO_MODE=true
